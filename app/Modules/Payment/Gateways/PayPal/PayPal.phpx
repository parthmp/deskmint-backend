<?php

namespace App\Modules\Payment\Gateways\PayPal;

use App\Enums\RecurringInvoices\Frequencies;
use App\Models\Transaction;
use App\Modules\InvoiceGeneration\InvoiceSnapshot;
use App\Modules\Payment\DatabaseOperations;
use App\Modules\Payment\Enums\PaymentGateway;
use App\Modules\Payment\Enums\TransactionStatus;
use App\Modules\Payment\Exceptions\PaymentException;
use App\Repositories\SettingsSection\SettingsSectionRepository;
use Exception;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Str;
use Srmklive\PayPal\Services\PayPal as PayPalClient;

class PayPal {

	private DatabaseOperations $database_operations;
	private PayPalClient $provider;
	private bool $subscription = false;
	private ?array $recurring_invoice = null;

	public function __construct(
		private int $company_id,
		private int $currency_id,
		private ?int $invoice_id,
		private ?int $pr_id,
		private int $user_id,
		private string $client_id,
		private string $app_id,
		private string $secret,
		private string $mode,
		private ?string $currency,
		private string $amount,
		?DatabaseOperations $database_operations = null,
		?PayPalClient $provider = null,
		bool $subscription = false
	){
		$this->database_operations = $database_operations ?? new DatabaseOperations(new SettingsSectionRepository());
		$this->provider = $provider ?? new PayPalClient($this->wireUpCreds());
		$token = $this->provider->getAccessToken();
		$this->subscription = $subscription;
	}

	/**
	 * setRecurringInvoiceData function
	 *
	 * @param array|null $recurring_invoice
	 * @return self
	 */
	public function setRecurringInvoiceData(?array $recurring_invoice) : self {
		$this->recurring_invoice = $recurring_invoice;
		return $this;
	}

	/**
	 * wireUpCreds function
	 *
	 * @return array
	 */
	private function wireUpCreds() : array {
		return [
			'payment_action'	=>	'Sale',
			'currency'			=>	$this->currency,
			//'notify_url'		=>	env('APP_URL').PAYMENT_NOTIFICATION_URL,
			'notify_url'		=>	'',
			'validate_ssl'		=>	true,
			'mode'				=>	$this->mode,
			'locale'			=>	'en_US',
			'sandbox' => [
				'client_id'         => $this->client_id,
				'client_secret'     => $this->secret,
				'app_id'            => $this->app_id
			],
			'live' => [
				'client_id'         => $this->client_id,
				'client_secret'     => $this->secret,
				'app_id'            => $this->app_id
			],
		];
	}

	/**
	 * orderData function
	 *
	 * @return array
	 */
	private function orderData() : array {
		return [
			"intent" => "CAPTURE",
			"purchase_units" => [
				[
					"amount" => [
						"currency_code" => $this->currency,
						"value" 		=> $this->amount
					]
				]
			],
			"application_context" => [
				"cancel_url" => env('APP_URL').PAYMENT_CANCEL_URL,
				"return_url" => env('APP_URL').PAYMENT_SUCCESS_URL,
			]
		];
	}

	/**
	 * createTransaction function
	 *
	 * @param string $order_id
	 * @return Transaction
	 */
	private function createTransaction(string $order_id) : Transaction {
		return $this->database_operations->insertTransaction([
			'currency_id'					=>	$this->currency_id,
			'company_id'					=>	$this->company_id,
			'amount'						=>	$this->amount,
			'payment_gateway'				=>	PaymentGateway::PAYPAL->value,
			'mode'							=>	$this->mode,
			'token_id_identifier'			=>	$order_id,
			'is_approved'					=>	0,
			'is_payment_captured'			=>	0,
			'status'						=>	(int) TransactionStatus::PENDING->value
		]);
	}

	/**
	 * ensurePaypalProduct function
	 *
	 * @return string
	 */
	private function ensurePaypalProduct() : string {

		$id = config('global.paypal_product_id');

		$existing = $this->provider->showProductDetails($id);

		if(isset($existing['id'])){
			return $existing['id']; // exists, reuse it
		}

		if(($existing['error']['name'] ?? null) === 'RESOURCE_NOT_FOUND'){
			$product = $this->provider->createProduct([
				'id'       => $id,
				'name'     => 'Recurring Subscription',
				'type'     => 'SERVICE',
				'category' => 'SOFTWARE',
			], 'product-main');

			if(!isset($product['id'])){
				throw new \RuntimeException('PayPal product create failed: ' . json_encode($product));
			}

			return $product['id'];
		}

		throw new \RuntimeException('Unexpected PayPal response: ' . json_encode($existing));

	}

	private function createPlan(string $product_id, array $recurring_invoice) : string {

		$freqency_array = Frequencies::getForPaypalFromValue((int) $recurring_invoice['frequency'], (int) $recurring_invoice['custom_frequency_days']);

		if(empty($freqency_array)){
			throw new \RuntimeException('Unexpected freqency_array value');
		}


		$plan = $this->provider->createPlan([
			'product_id' => $product_id,
			'name'       => 'Subscription Plan',
			'status'     => 'ACTIVE',
			'billing_cycles' => [
				[
					'frequency'      => $freqency_array,
					'tenure_type'    => 'REGULAR',
					'sequence'       => 1,
					'total_cycles'   => 0,
					'pricing_scheme' => [
						'fixed_price' => ['value' => $recurring_invoice['total'], 'currency_code' => $recurring_invoice['code']],
					],
				],
			],
			'payment_preferences' => [
				'auto_bill_outstanding'     => true,
				'setup_fee'                 => ['value' => '0', 'currency_code' => $recurring_invoice['code']],
				'setup_fee_failure_action'  => 'CONTINUE',
				'payment_failure_threshold' => 3,
			],
		]);
		
		$plan_id = $plan['id'];
		return $plan_id;

	}

	/**
	 * createSubscription function
	 *
	 * @param string $plan_id
	 * @return array
	 */
	private function createSubscription(string $plan_id) : array {

		$response = $this->provider->createSubscription([
			'plan_id'    => $plan_id,
			'custom_id'  => (string) $this->recurring_invoice['id'],
			'subscriber' => [
				'name' => [
					'given_name' => $this->recurring_invoice['first_name'],
					'surname'    => $this->recurring_invoice['last_name'],
				],
				'email_address' => $this->recurring_invoice['email'],
			],
			'application_context' => [
				'brand_name'          => config('app.name'),
				'locale'              => 'en-US',
				'shipping_preference' => 'NO_SHIPPING',
				'user_action'         => 'SUBSCRIBE_NOW',
				'payment_method'      => [
					'payer_selected'  => 'PAYPAL',
					'payee_preferred' => 'IMMEDIATE_PAYMENT_REQUIRED',
				],
				"cancel_url" => env('APP_URL').PAYMENT_CANCEL_URL,
				"return_url" => env('APP_URL').PAYMENT_SUCCESS_URL
			],
		]);

		if(!isset($response['id'])){
			throw new \RuntimeException('PayPal subscription create failed: ' . json_encode($response));
		}
		
		$approve_url = collect($response['links'])->firstWhere('rel', 'approve')['href'] ?? null;

		if(!$approve_url){
			throw new \RuntimeException('No approve link: ' . json_encode($response));
		}

		return [
			'url'	=>	$approve_url,
			'id'	=>	$response['id'],
		];

	}

	/**
	 * fetchPendingApproveUrl function
	 *
	 * @param string $plan_id
	 * @param string $gateway_subscription_id
	 * @return string|null
	 */
	private function fetchPendingApproveUrl(string $plan_id, string $gateway_subscription_id): ?string {

		try{

			$plan = $this->provider->showPlanDetails($plan_id);

			if(($plan['status'] ?? null) !== 'ACTIVE'){
				return null;
			}

			$sub = $this->provider->showSubscriptionDetails($gateway_subscription_id);

			if(($sub['status'] ?? null) !== 'APPROVAL_PENDING'){
				return null;
			}

			$approve = collect($sub['links'] ?? [])->firstWhere('rel', 'approve');

			return $approve['href'] ?? null;

		}catch(\Throwable $e){
			return null;
		}

	}

	/**
	 * insertRecurringInvoiceUrl function
	 *
	 * @param string $url
	 * @return boolean
	 */
	private function insertRecurringInvoiceUrl(string $url) : bool {
		return $this->database_operations->insertRecurringInvoiceUrl([
			'company_id'				=>	$this->recurring_invoice['company_id'],
			'recurring_invoice_id'		=>	$this->recurring_invoice['id'],
			'payment_gateway'			=>	$this->recurring_invoice['payment_gateway'],
			'total'						=>	$this->recurring_invoice['total'],
			'currency_id'				=>	$this->recurring_invoice['currency_id'],
			'url'						=>	$url
		]);
	}

	/**
	 * generateURL function
	 *
	 * @return string|null
	 */
	public function generateURL() : ?string {

		if($this->subscription){

			if(!$this->recurring_invoice){
				throw new Exception("unable to create url for recurring invoice");
			}

			$plan = $this->database_operations->fetchSubscriptionPlanByRI((int) $this->recurring_invoice['company_id'], (int) $this->recurring_invoice['id'], (int) $this->recurring_invoice['payment_gateway']);
			

			if($plan){

				$url_exists = $this->fetchPendingApproveUrl($plan->plan_id, $plan->gateway_subscription_id);
				
				if($url_exists){

					$this->insertRecurringInvoiceUrl($url_exists);
					return $url_exists;

				}
			}
			

			$product_id = $this->ensurePaypalProduct();

			//makes api call to paypal
			$plan_id = $this->createPlan($product_id, $this->recurring_invoice);
			//makes api call to paypal
			$sub_data = $this->createSubscription($plan_id);

			$data = [
				'company_id'				=>	$this->recurring_invoice['company_id'],
				'recurring_invoice_id'		=>	$this->recurring_invoice['id'],
				'payment_gateway'			=>	$this->recurring_invoice['payment_gateway'],
				'gateway_subscription_id'	=>	$sub_data['id'],
				'plan_id'					=>	$plan_id,
				'payer_id'					=>	'',
				'customer_id'				=>	'',
			];

			return DB::transaction(function () use ($data, $sub_data) {

				$this->database_operations->insertSubScriptionPlan($data);

				$this->insertRecurringInvoiceUrl($sub_data['url']);

				return $sub_data['url'];

			});
			
		}else{
			
			$transaction_reference = $this->database_operations->upsertTransactionReference((int) $this->company_id, (int) $this->user_id, $this->invoice_id, $this->pr_id);
		
			$response = $this->provider->createOrder($this->orderData());

			if(isset($response['id']) && $response['id'] != null){
				foreach($response['links'] as $link) {
					if($link['rel'] === 'approve'){
						$transaction = $this->createTransaction($response['id']);
						$this->database_operations->upsertTransactionReference((int) $this->company_id, (int) $this->user_id, $this->invoice_id, $this->pr_id, (int) $transaction->id, (int) $transaction_reference->id);
						$this->database_operations->insertEmptyTransactionGatewayDetails($transaction->id);
						$url = $link['href'];
						$this->database_operations->insertPaymentUrl($transaction->id, $this->invoice_id, $response['id'], $url);
						return $url;
					}
				}
			}

		}

		

		return null;
		
   	}

	/**
	 * verifyAuthenticity function
	 *
	 * @param Request $request
	 * @param string $webhook_id
	 * @return boolean
	 */
	private function verifyAuthenticity(Request $request, string $webhook_id) : bool {

		$headers = collect($request->headers->all())->map(fn($value) => $value[0])->all();

		$valid = $this->provider->verifyWebHookLocally($headers, $webhook_id, $request->getContent());

		return $valid;

	}

	/**
	 * handlePayment function
	 *
	 * @return boolean
	 */
	public function handlePayment(array $data, Request $request) : bool {
		
		if(!$this->verifyAuthenticity($request, $data['webhook_id'])){
			throw new PaymentException('unauthorized', 'unauthorized', 401);
		}

		$event_type = $data['event_type'] ?? null;
		
		if((string) $event_type !== 'CHECKOUT.ORDER.APPROVED' && (string) $event_type !== 'PAYMENT.CAPTURE.COMPLETED' && (string) $event_type !== 'PAYMENT.CAPTURE.PENDING'){
			throw new PaymentException('Invalid data provided', 'invalid_event_type', config('global.error_code'));
		}

		try{
			
			if((string) $event_type === 'CHECKOUT.ORDER.APPROVED'){
				$this->provider->capturePaymentOrder($data['order_id']);
			}
		
		}catch(Exception $e){
			throw new Exception('something went wrong!');
		}
		
		if((string) $event_type === 'PAYMENT.CAPTURE.COMPLETED'){
			
			$status = $data['resource']['status'];

			if($status !== 'COMPLETED'){
				return true;
			}
			
			$transaction = $this->database_operations->fetchTransactionByTokenId($data['order_id']);
			
			if($transaction->is_payment_captured){

				return true;
			}
			
		}
		
		return $this->database_operations->updatePaymentTransaction($data);

		
	}

	

}